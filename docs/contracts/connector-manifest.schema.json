{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabrihomeopathy.com/schemas/file-26/connector-manifest-v1.json",
  "title": "Sabri File 26 Connector Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connector_key",
    "owner_file",
    "contract_version",
    "entity_types",
    "privacy_classes",
    "cursor_strategy",
    "change_source",
    "rebuild_method",
    "deletion_semantics",
    "health_check"
  ],
  "properties": {
    "connector_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,99}$"
    },
    "owner_file": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "entity_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{1,79}$"
      }
    },
    "privacy_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["C1", "C2", "C3", "C4", "C5"]
      }
    },
    "cursor_strategy": {"type": "string", "minLength": 1, "maxLength": 191},
    "change_source": {"type": "string", "minLength": 1, "maxLength": 191},
    "rebuild_method": {"type": "string", "minLength": 1, "maxLength": 191},
    "deletion_semantics": {"type": "string", "minLength": 1, "maxLength": 191},
    "health_check": {"type": "string", "minLength": 1, "maxLength": 191}
  }
}
